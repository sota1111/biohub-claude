# Competition data — Kaggle data is not redistributable
/data/
!/data/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# Submissions / scratch
submission*.csv
*.tmp

# Experiment scratch
.worktrees/
experiments/**/*.csv

# SOT-2994 detection cache (regenerable, large)
experiments/sot2994/cache/
experiments/**/*.log
